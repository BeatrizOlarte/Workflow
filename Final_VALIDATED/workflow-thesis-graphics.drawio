        <mxCell id="8H4uNFnZ9CfENqtzcJ4J-98" value="&lt;span style=&quot;font-size: 8px;&quot;&gt;Sales Order&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;" parent="xF8kSWalujdfLcc4dFP9-1" vertex="1">
