        <mxCell id="TjP3_M4Hx8MqOBJ_lKGI-24" value="" style="ellipse;fillColor=strokeColor;html=1;" vertex="1" parent="TjP3_M4Hx8MqOBJ_lKGI-20">
          <mxGeometry x="167.5" y="647.5" width="15" height="15" as="geometry" />
        </mxCell>
        <mxCell id="TjP3_M4Hx8MqOBJ_lKGI-25" value="TASK" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f0a30a;fontColor=#000000;strokeColor=#BD7000;" vertex="1" parent="TjP3_M4Hx8MqOBJ_lKGI-20">
          <mxGeometry x="50" y="200" width="120" height="60" as="geometry" />
        </mxCell>
