        <mxCell id="wVC6D8RXUOWE8VFI2YlK-56" value="Adapted to the data provided from Celada, it could be extended in the future" style="whiteSpace=wrap;html=1;aspect=fixed;fillColor=#f1ff33;fontColor=#000000;" vertex="1" parent="wVC6D8RXUOWE8VFI2YlK-46">
