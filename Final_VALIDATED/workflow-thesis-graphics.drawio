          <mxGeometry x="1740" y="329" width="360" height="430" as="geometry" />
        </mxCell>
        <mxCell id="cKjXAFAfdylflfae3vtH-62" value="&lt;font color=&quot;#000000&quot;&gt;Implemented in code, given 2 workpieces 1 raw workpiece and 1 final identifies the manufacturing features&lt;/font&gt;" style="whiteSpace=wrap;html=1;aspect=fixed;fillColor=#33FF99;" vertex="1" parent="cKjXAFAfdylflfae3vtH-56">
          <mxGeometry x="580" y="530" width="110" height="110" as="geometry" />
        </mxCell>
        <mxCell id="cKjXAFAfdylflfae3vtH-63" value="&lt;font color=&quot;#050505&quot;&gt;Implemented in code, it recognise features, classifies them and then identified if milling or turning is more suitable&lt;/font&gt;" style="whiteSpace=wrap;html=1;aspect=fixed;fillColor=#33FF99;" vertex="1" parent="cKjXAFAfdylflfae3vtH-56">
          <mxGeometry x="1180" y="440" width="110" height="110" as="geometry" />
        </mxCell>
        <mxCell id="cKjXAFAfdylflfae3vtH-64" value="&lt;font color=&quot;#000000&quot;&gt;Implemented with the G.S. Thesis&lt;/font&gt;" style="whiteSpace=wrap;html=1;aspect=fixed;fillColor=#33FF99;" vertex="1" parent="cKjXAFAfdylflfae3vtH-56">
          <mxGeometry x="2220" y="690" width="70" height="70" as="geometry" />
        </mxCell>
        <mxCell id="cKjXAFAfdylflfae3vtH-65" value="&lt;font color=&quot;#000000&quot;&gt;Implemented, mapping the data from Celada in a KG&lt;/font&gt;" style="whiteSpace=wrap;html=1;aspect=fixed;fillColor=#33FF99;strokeColor=#000000;" vertex="1" parent="cKjXAFAfdylflfae3vtH-56">
