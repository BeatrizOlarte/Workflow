            <mxPoint x="40" y="1010" as="sourcePoint" />
            <mxPoint x="180" y="1010" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="zYaOjDMjuHtK-QZQqYhO-43" value="&lt;font color=&quot;#333333&quot;&gt;Information about Revision Process of the Workflow&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fillColor=#F05716;" vertex="1" parent="zYaOjDMjuHtK-QZQqYhO-16">
          <mxGeometry x="50" y="1150" width="110" height="90" as="geometry" />
        </mxCell>
        <mxCell id="zYaOjDMjuHtK-QZQqYhO-44" value="Orange Lines show the revision process when the customer requirements haven&#39;t been satisfied. These branches/loops will be executed a max. amount of&amp;nbsp; times (i.e. three) and you will just enter if you haven&#39;t satisfied the requirements" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="zYaOjDMjuHtK-QZQqYhO-16">
          <mxGeometry x="10" y="1040" width="190" height="80" as="geometry" />
        </mxCell>
        <mxCell id="ZW6jnNAsVxy6p-1vUkPo-0" value="When the customer transfers all the information, the supplier reviews the geometrical information of the workpiece, compares the volume they need to remove and identifies the features that the machine tool needs to create." style="whiteSpace=wrap;html=1;aspect=fixed;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="zYaOjDMjuHtK-QZQqYhO-16">
