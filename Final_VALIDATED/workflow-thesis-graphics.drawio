        <mxCell id="zYaOjDMjuHtK-QZQqYhO-51" value="&lt;font color=&quot;#000000&quot;&gt;Implemented in code, given 2 workpieces 1 raw workpiece and 1 final identifies the manufacturing features&lt;/font&gt;" style="whiteSpace=wrap;html=1;aspect=fixed;fillColor=#33FF99;" vertex="1" parent="zYaOjDMjuHtK-QZQqYhO-45">
