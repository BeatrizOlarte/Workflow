        </mxCell>
        <mxCell id="SbeDv9eEClHbdYY0RWsB-53" value="&lt;font color=&quot;#000000&quot;&gt;Implemented in code, given 2 workpieces 1 raw workpiece and 1 final identifies the manufacturing features&lt;/font&gt;" style="whiteSpace=wrap;html=1;aspect=fixed;fillColor=#33FF99;" vertex="1" parent="SbeDv9eEClHbdYY0RWsB-47">
          <mxGeometry x="580" y="530" width="110" height="110" as="geometry" />
        </mxCell>
        <mxCell id="SbeDv9eEClHbdYY0RWsB-54" value="&lt;font color=&quot;#050505&quot;&gt;Implemented in code, it recognise features, classifies them and then identified if milling or turning is more suitable&lt;/font&gt;" style="whiteSpace=wrap;html=1;aspect=fixed;fillColor=#33FF99;" vertex="1" parent="SbeDv9eEClHbdYY0RWsB-47">
          <mxGeometry x="1180" y="440" width="110" height="110" as="geometry" />
        </mxCell>
