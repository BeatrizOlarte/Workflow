        <mxCell id="TjP3_M4Hx8MqOBJ_lKGI-27" value="" style="rhombus;whiteSpace=wrap;html=1;" vertex="1" parent="TjP3_M4Hx8MqOBJ_lKGI-20">
          <mxGeometry x="90" y="420" width="60" height="60" as="geometry" />
        </mxCell>
        <mxCell id="TjP3_M4Hx8MqOBJ_lKGI-28" value="Decision Point" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="TjP3_M4Hx8MqOBJ_lKGI-20">
          <mxGeometry x="60" y="390" width="120" height="30" as="geometry" />
        </mxCell>
        <mxCell id="TjP3_M4Hx8MqOBJ_lKGI-29" value="&lt;span style=&quot;font-size: 8px;&quot;&gt;INPUT/OUTPUT&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;" vertex="1" parent="TjP3_M4Hx8MqOBJ_lKGI-20">
          <mxGeometry x="58" y="71" width="100" height="40" as="geometry" />
        </mxCell>
        <mxCell id="TjP3_M4Hx8MqOBJ_lKGI-30" value="END" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="TjP3_M4Hx8MqOBJ_lKGI-20">
          <mxGeometry x="140" y="610" width="80" height="30" as="geometry" />
        </mxCell>
        <mxCell id="TjP3_M4Hx8MqOBJ_lKGI-31" value="" style="ellipse;whiteSpace=wrap;html=1;fillColor=#f5f5f5;fontColor=#333333;strokeColor=#666666;" vertex="1" parent="TjP3_M4Hx8MqOBJ_lKGI-20">
          <mxGeometry x="60" y="640" width="30" height="30" as="geometry" />
        </mxCell>
        <mxCell id="TjP3_M4Hx8MqOBJ_lKGI-32" value="&lt;span style=&quot;font-size: 8px;&quot;&gt;INFORMATION / KNOWLEDGE&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#1ba1e2;fontColor=#ffffff;strokeColor=#006EAF;" vertex="1" parent="TjP3_M4Hx8MqOBJ_lKGI-20">
          <mxGeometry x="40" y="140" width="140" height="40" as="geometry" />
        </mxCell>
        <mxCell id="TjP3_M4Hx8MqOBJ_lKGI-33" value="Input/Output already mentioned" style="shape=document;whiteSpace=wrap;html=1;boundedLbl=1;" vertex="1" parent="TjP3_M4Hx8MqOBJ_lKGI-20">
          <mxGeometry x="63" y="692" width="120" height="80" as="geometry" />
        </mxCell>
        <mxCell id="TjP3_M4Hx8MqOBJ_lKGI-34" value="START" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="TjP3_M4Hx8MqOBJ_lKGI-20">
          <mxGeometry x="10" y="610" width="120" height="30" as="geometry" />
        </mxCell>
        <mxCell id="TjP3_M4Hx8MqOBJ_lKGI-35" value="" style="endArrow=none;dashed=1;html=1;dashPattern=1 3;strokeWidth=2;rounded=0;" edge="1" parent="TjP3_M4Hx8MqOBJ_lKGI-20">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="182" y="350" as="sourcePoint" />
            <mxPoint x="182" y="290" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="TjP3_M4Hx8MqOBJ_lKGI-36" value="Link between&amp;nbsp;&lt;div&gt;method and task&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;/div&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="TjP3_M4Hx8MqOBJ_lKGI-20">
          <mxGeometry x="123" y="356" width="120" height="30" as="geometry" />
        </mxCell>
        <mxCell id="TjP3_M4Hx8MqOBJ_lKGI-37" value="" style="endArrow=classic;html=1;rounded=0;" edge="1" parent="TjP3_M4Hx8MqOBJ_lKGI-20">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="48" y="521" as="sourcePoint" />
            <mxPoint x="188" y="521" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="TjP3_M4Hx8MqOBJ_lKGI-38" value="Input/Output to" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="TjP3_M4Hx8MqOBJ_lKGI-20">
          <mxGeometry x="40" y="490" width="120" height="30" as="geometry" />
        </mxCell>
        <mxCell id="TjP3_M4Hx8MqOBJ_lKGI-39" value="" style="endArrow=classic;html=1;rounded=0;dashed=1;" edge="1" parent="TjP3_M4Hx8MqOBJ_lKGI-20">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="46" y="574" as="sourcePoint" />
            <mxPoint x="186" y="574" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="TjP3_M4Hx8MqOBJ_lKGI-40" value="Communication" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="TjP3_M4Hx8MqOBJ_lKGI-20">
          <mxGeometry x="30" y="540" width="170" height="30" as="geometry" />
        </mxCell>
        <mxCell id="TjP3_M4Hx8MqOBJ_lKGI-41" value="" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;" vertex="1" parent="TjP3_M4Hx8MqOBJ_lKGI-20">
          <mxGeometry x="62" y="783" width="60" height="80" as="geometry" />
        </mxCell>
        <mxCell id="TjP3_M4Hx8MqOBJ_lKGI-42" value="Info to Database" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="TjP3_M4Hx8MqOBJ_lKGI-20">
          <mxGeometry x="122" y="793" width="60" height="30" as="geometry" />
        </mxCell>
        <mxCell id="TjP3_M4Hx8MqOBJ_lKGI-43" value="&lt;font color=&quot;#333333&quot;&gt;The process starts when a company receives an enquiry email from a customer interested in buying a machine tool or machine tending solution. The company will reply back asking for more information; if they don&#39;t reply, the process finishes. If they reply to the requirements definition, a bad understanding of the requirements can produce a cost of failure in the supplier company.&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fillColor=#FFFFFF;" vertex="1" parent="TjP3_M4Hx8MqOBJ_lKGI-20">
          <mxGeometry x="270" y="540" width="224" height="190" as="geometry" />
        </mxCell>
        <mxCell id="TjP3_M4Hx8MqOBJ_lKGI-44" value="&lt;font color=&quot;#333333&quot;&gt;The process starts when a company receives an enquiry email from a customer interested in buying a machine tool or machine tending solution. The company will reply back asking for more information; if they don&#39;t reply, the process finishes. If they reply, the requirements definition, a bad requirements unederstanding can produce a cost of failure in the supplier company.&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fillColor=#FFFFFF;" vertex="1" parent="TjP3_M4Hx8MqOBJ_lKGI-20">
          <mxGeometry x="271" y="540" width="220" height="190" as="geometry" />
        </mxCell>
        <mxCell id="TjP3_M4Hx8MqOBJ_lKGI-45" value="&lt;font color=&quot;#333333&quot;&gt;Information about Workflow&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fillColor=#FFFFFF;" vertex="1" parent="TjP3_M4Hx8MqOBJ_lKGI-20">
          <mxGeometry x="40" y="880" width="110" height="90" as="geometry" />
        </mxCell>
        <mxCell id="TjP3_M4Hx8MqOBJ_lKGI-46" value="" style="endArrow=classic;html=1;rounded=0;strokeColor=#F05716;" edge="1" parent="TjP3_M4Hx8MqOBJ_lKGI-20">
          <mxGeometry width="50" height="50" relative="1" as="geometry">
            <mxPoint x="40" y="1010" as="sourcePoint" />
            <mxPoint x="180" y="1010" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="TjP3_M4Hx8MqOBJ_lKGI-47" value="&lt;font color=&quot;#333333&quot;&gt;Information about Revision Process of the Workflow&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fillColor=#F05716;" vertex="1" parent="TjP3_M4Hx8MqOBJ_lKGI-20">
          <mxGeometry x="50" y="1150" width="110" height="90" as="geometry" />
        </mxCell>
        <mxCell id="TjP3_M4Hx8MqOBJ_lKGI-48" value="Orange Lines show the revision process when the customer requirements haven&#39;t been satisfied. These branches/loops will be executed a max. amount of&amp;nbsp; times (i.e. three) and you will just enter if you haven&#39;t satisfied the requirements" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="TjP3_M4Hx8MqOBJ_lKGI-20">
          <mxGeometry x="10" y="1040" width="190" height="80" as="geometry" />
        </mxCell>
        <mxCell id="TjP3_M4Hx8MqOBJ_lKGI-49" value="When the customer transfers all the information, the supplier reviews the geometrical information of the workpiece, compares the volume they need to remove and identifies the features that the machine tool needs to create." style="whiteSpace=wrap;html=1;aspect=fixed;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="TjP3_M4Hx8MqOBJ_lKGI-20">
          <mxGeometry x="580" y="600" width="170" height="170" as="geometry" />
        </mxCell>
        <mxCell id="TjP3_M4Hx8MqOBJ_lKGI-50" value="&lt;span style=&quot;color: rgb(51, 51, 51);&quot;&gt;Manufacturing knowledge allows to associate geometrical features with the most suitable machining technology. Experience enables to understand by rules what the best technology is for a given geometry. i.e. if the percentage of the milling features is considerable higher than the turning features after a human decision process a milling machine tool might be preferred over a multi-axis.&lt;/span&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fillColor=#FFFFFF;" vertex="1" parent="TjP3_M4Hx8MqOBJ_lKGI-20">
          <mxGeometry x="1160" y="400" width="150" height="230" as="geometry" />
        </mxCell>
        <mxCell id="TjP3_M4Hx8MqOBJ_lKGI-51" value="Clamping a workpiece to a machine tool is a complex decision making. It needs the right technology and the right position for obtaining the workpiece" style="whiteSpace=wrap;html=1;aspect=fixed;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="TjP3_M4Hx8MqOBJ_lKGI-20">
          <mxGeometry x="1164" y="690" width="150" height="150" as="geometry" />
        </mxCell>
        <mxCell id="TjP3_M4Hx8MqOBJ_lKGI-52" value="&lt;font color=&quot;#333333&quot;&gt;Once we know how to grip the part, we define and schedule the operations that will follow according to our knowledge to respect the assigned tolerances. Once we know the order of the machining operations, we assign the best cutting parameters to them according to a certain criterion. To do so, we need to understand what speed, more or less (machine tool power), we will have. So we need to preset some unless it is given by the customer. After that, we need to find the cutting tools that will provide those cutting parameters. If we are okay with the time, we can review the machining process with an expert to verify our assumptions.&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fillColor=#FFFFFF;" vertex="1" parent="TjP3_M4Hx8MqOBJ_lKGI-20">
          <mxGeometry x="1540" y="760" width="240" height="230" as="geometry" />
        </mxCell>
        <mxCell id="TjP3_M4Hx8MqOBJ_lKGI-53" value="Knowing the processes we are in the search of the machine tool that will satisfy the production in terms of time and quality. Most of the machine tools can perform all the machining operations, but some are most suitable in terms of space and performance" style="whiteSpace=wrap;html=1;aspect=fixed;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="TjP3_M4Hx8MqOBJ_lKGI-20">
          <mxGeometry x="2920" y="280" width="160" height="160" as="geometry" />
        </mxCell>
        <mxCell id="TjP3_M4Hx8MqOBJ_lKGI-54" value="&lt;font color=&quot;#333333&quot;&gt;You have selected the model, but now you might need to configure with special requirements as chip conveyor, double spindle, etc. Not all the candidates might have the same configuration capabilities.&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fillColor=#FFFFFF;" vertex="1" parent="TjP3_M4Hx8MqOBJ_lKGI-20">
          <mxGeometry x="2914" y="610" width="150" height="130" as="geometry" />
        </mxCell>
        <mxCell id="TjP3_M4Hx8MqOBJ_lKGI-55" value="&lt;span style=&quot;color: rgb(51, 51, 51);&quot;&gt;Once we have the machine tool, we know its specifications, torque, speed, dimensions, passive times, ... This will help us calculate the throughput&lt;/span&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fillColor=#FFFFFF;" vertex="1" parent="TjP3_M4Hx8MqOBJ_lKGI-20">
          <mxGeometry x="3340" y="530" width="140" height="130" as="geometry" />
        </mxCell>
        <mxCell id="TjP3_M4Hx8MqOBJ_lKGI-56" value="We link machine tool processing to the Process Plan to have the complete cycle time (i.e. tool change times, ...)" style="whiteSpace=wrap;html=1;aspect=fixed;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="TjP3_M4Hx8MqOBJ_lKGI-20">
          <mxGeometry x="3336" y="380" width="100" height="100" as="geometry" />
        </mxCell>
        <mxCell id="TjP3_M4Hx8MqOBJ_lKGI-57" value="&lt;font color=&quot;#333333&quot;&gt;We compare how the throughput that our process plan produce aligns with the Customer Requirements.&amp;nbsp;&amp;nbsp;&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fillColor=#FFFFFF;" vertex="1" parent="TjP3_M4Hx8MqOBJ_lKGI-20">
          <mxGeometry x="3112" y="740" width="160" height="67" as="geometry" />
        </mxCell>
        <mxCell id="TjP3_M4Hx8MqOBJ_lKGI-58" value="&lt;font color=&quot;#333333&quot;&gt;When achieving the customer&#39;s desired throughput, and automation is no longer required, the quote process concludes, and the sales discussion begins, till reaching or not a commercial agreement&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fillColor=#FFFFFF;" vertex="1" parent="TjP3_M4Hx8MqOBJ_lKGI-20">
          <mxGeometry x="3830" y="380" width="226" height="123.5" as="geometry" />
        </mxCell>
        <mxCell id="TjP3_M4Hx8MqOBJ_lKGI-59" value="&lt;font color=&quot;#333333&quot;&gt;If the customer also wants an automatic loading and unloading of the machine tool, the quotation process needs to continue. The first step is to understand the requirements of the cell. How to input material, space for materials, cleaning stations, and engraving. If this is not clear, we can propose a solution, but the customers must agree. If they don&#39;t, the process finished. If they agree, the first asset to be designed is the gripper, which will help understand the robot&#39;s payload and reachability. We might need to use more than one gripper.&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fillColor=#FFFFFF;" vertex="1" parent="TjP3_M4Hx8MqOBJ_lKGI-20">
          <mxGeometry x="3780" y="670" width="240" height="220" as="geometry" />
        </mxCell>
        <mxCell id="TjP3_M4Hx8MqOBJ_lKGI-60" value="&lt;span style=&quot;color: rgb(51, 51, 51);&quot;&gt;If&lt;/span&gt;&lt;font color=&quot;#333333&quot;&gt;&amp;nbsp;we are close to the target throughput we will start the revisions. Just increasing the cutting parameters or changing some operations we could reach the solution for the customer. This information will be provided by an expert who is also a machinist. Of course, we need to verify that our machine tool is still compliant; otherwise, we need to change it. If we need to change it, probably for one more powerful, we could use the candidates from the previous search to save some time.&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fillColor=#F05716;" vertex="1" parent="TjP3_M4Hx8MqOBJ_lKGI-20">
          <mxGeometry x="2630" y="1130" width="260" height="210" as="geometry" />
        </mxCell>
        <mxCell id="TjP3_M4Hx8MqOBJ_lKGI-61" value="&lt;font color=&quot;#333333&quot;&gt;If we are a bit lower from the desired throughput (between 0.75 and 0.9),&amp;nbsp; we might need to change more operations, and this will probably result in a new machine tool range/ series/ model.&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fillColor=#F05716;" vertex="1" parent="TjP3_M4Hx8MqOBJ_lKGI-20">
          <mxGeometry x="3350" y="1120" width="140" height="130" as="geometry" />
        </mxCell>
        <mxCell id="TjP3_M4Hx8MqOBJ_lKGI-62" value="&lt;font color=&quot;#333333&quot;&gt;If the throughput is lower than 75% of the Customer Requirements, we we should go back to the customer to discuss the requirements, as they probably need to increase the budget to go for a higher specs machine tool.&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fillColor=#F05716;strokeColor=#F05716;" vertex="1" parent="TjP3_M4Hx8MqOBJ_lKGI-20">
          <mxGeometry x="3210" y="190" width="190" height="120" as="geometry" />
        </mxCell>
        <mxCell id="TjP3_M4Hx8MqOBJ_lKGI-63" value="&lt;font color=&quot;#333333&quot;&gt;This branch won&#39;t be executed when there is the need of just one gripper (end effector)&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fillColor=#FFFFFF;" vertex="1" parent="TjP3_M4Hx8MqOBJ_lKGI-20">
          <mxGeometry x="5060" y="1144" width="510" height="30" as="geometry" />
        </mxCell>
        <mxCell id="TjP3_M4Hx8MqOBJ_lKGI-64" value="Once the design is complete, we need to transfer the solution to the simulation team. They check for interferences in the path of the robot, avoiding death angles, full reachability and a good cycle time of the cell. If these premises are not valid, the designer might need to change the layout or the robot. Also, it is essential to check its compliance with machinery safety prior to any submissions to the customer. A changes afterwards will be more expensive." style="whiteSpace=wrap;html=1;aspect=fixed;fillColor=#f5f5f5;strokeColor=#666666;fontColor=#333333;" vertex="1" parent="TjP3_M4Hx8MqOBJ_lKGI-20">
          <mxGeometry x="5850" y="1880" width="208" height="208" as="geometry" />
        </mxCell>
        <mxCell id="TjP3_M4Hx8MqOBJ_lKGI-65" value="&lt;font color=&quot;#333333&quot;&gt;When everything is checked, the layout, simulation, and bill of materials are sent to the sales engineer. He needs to provide a quote with the price and the condition to the customer.&lt;/font&gt;" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fillColor=#FFFFFF;" vertex="1" parent="TjP3_M4Hx8MqOBJ_lKGI-20">
          <mxGeometry x="6260" y="980" width="200" height="120" as="geometry" />
        </mxCell>
        <mxCell id="TjP3_M4Hx8MqOBJ_lKGI-66" value="ImplementedTasks" style="" visible="0" parent="TjP3_M4Hx8MqOBJ_lKGI-0" />
        <mxCell id="TjP3_M4Hx8MqOBJ_lKGI-67" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;strokeColor=#33FF99;strokeWidth=3;fillColor=none;" vertex="1" parent="TjP3_M4Hx8MqOBJ_lKGI-66">
          <mxGeometry x="570" y="465" width="520" height="345" as="geometry" />
        </mxCell>
        <mxCell id="TjP3_M4Hx8MqOBJ_lKGI-68" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;strokeColor=#33FF99;strokeWidth=3;fillColor=none;" vertex="1" parent="TjP3_M4Hx8MqOBJ_lKGI-66">
          <mxGeometry x="1940" y="760" width="410" height="140" as="geometry" />
        </mxCell>
        <mxCell id="TjP3_M4Hx8MqOBJ_lKGI-69" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;strokeColor=#33FF99;strokeWidth=3;fillColor=none;" vertex="1" parent="TjP3_M4Hx8MqOBJ_lKGI-66">
          <mxGeometry x="1180" y="330" width="450" height="300" as="geometry" />
        </mxCell>
        <mxCell id="TjP3_M4Hx8MqOBJ_lKGI-70" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;strokeColor=#33FF99;strokeWidth=3;fillColor=none;" vertex="1" parent="TjP3_M4Hx8MqOBJ_lKGI-66">
          <mxGeometry x="2790" y="680" width="250" height="140" as="geometry" />
        </mxCell>
        <mxCell id="TjP3_M4Hx8MqOBJ_lKGI-71" value="" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;strokeColor=#fcff33;strokeWidth=3;fillColor=none;" vertex="1" parent="TjP3_M4Hx8MqOBJ_lKGI-66">
          <mxGeometry x="1740" y="329" width="360" height="430" as="geometry" />
        </mxCell>
        <mxCell id="TjP3_M4Hx8MqOBJ_lKGI-72" value="&lt;font color=&quot;#000000&quot;&gt;Implemented in code, given 2 workpieces 1 raw workpiece and 1 final identifies the manufacturing features&lt;/font&gt;" style="whiteSpace=wrap;html=1;aspect=fixed;fillColor=#33FF99;" vertex="1" parent="TjP3_M4Hx8MqOBJ_lKGI-66">
          <mxGeometry x="580" y="530" width="110" height="110" as="geometry" />
        </mxCell>
        <mxCell id="TjP3_M4Hx8MqOBJ_lKGI-73" value="&lt;font color=&quot;#050505&quot;&gt;Implemented in code, it recognise features, classifies them and then identified if milling or turning is more suitable&lt;/font&gt;" style="whiteSpace=wrap;html=1;aspect=fixed;fillColor=#33FF99;" vertex="1" parent="TjP3_M4Hx8MqOBJ_lKGI-66">
          <mxGeometry x="1180" y="440" width="110" height="110" as="geometry" />
        </mxCell>
        <mxCell id="TjP3_M4Hx8MqOBJ_lKGI-74" value="&lt;font color=&quot;#000000&quot;&gt;Implemented with the G.S. Thesis&lt;/font&gt;" style="whiteSpace=wrap;html=1;aspect=fixed;fillColor=#33FF99;" vertex="1" parent="TjP3_M4Hx8MqOBJ_lKGI-66">
